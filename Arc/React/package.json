    "@cratis/components": "^2.4.1",
    "@cratis/fundamentals": "7.18.1",
    "mobx": "6.16.1",
    "mobx-react": "9.2.2",
    "primeicons": "7.0.0",
    "primereact": "10.9.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "reflect-metadata": "0.2.2",
    "ts-deepmerge": "8.0.0",
    "tsyringe": "4.10.0"
