<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <AssemblyName>Arc.React</AssemblyName>
        <RootNamespace>Arc.React</RootNamespace>
        <GenerateDependencyFile>true</GenerateDependencyFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
        <OutputType>Exe</OutputType>
        <!-- Arc artifacts form a public API; NU1506 is inherited from the root's case-variant test SDK entries. -->
        <NoWarn>$(NoWarn);CA1515;NU1506</NoWarn>
        <CratisProxiesOutputPath>$(MSBuildThisFileDirectory)</CratisProxiesOutputPath>
        <CratisProxiesSegmentsToSkip>2</CratisProxiesSegmentsToSkip>
        <CratisProxiesSkipOutputDeletion>true</CratisProxiesSkipOutputDeletion>
        <CratisProxiesSkipCommandNameInRoute>true</CratisProxiesSkipCommandNameInRoute>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Arc.React.Specs/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Arc" />
        <PackageReference Include="Cratis.Arc.ProxyGenerator.Build" />
        <PackageReference Include="Cratis.Fundamentals" />
    </ItemGroup>

</Project>
