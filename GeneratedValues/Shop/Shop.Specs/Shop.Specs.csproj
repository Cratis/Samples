<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <RootNamespace>Shop.Specs</RootNamespace>
        <!-- Cratis Specifications uses snake_case facts, inline attributes, and convention-based teardown. -->
        <NoWarn>$(NoWarn);CA1001;CA1515;IDE1006;SA1134</NoWarn>
        <!-- Pins parse literal text, as a Screenplay fixture would, so they can be recovered into the model. -->
        <NoWarn>$(NoWarn);MA0176</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- In-process Arc command scenarios. The repository's central package list has no entry for it yet,
             so the version is pinned here to the released Arc version the repository uses. -->
        <PackageReference Include="Cratis.Arc.Chronicle.Testing" />
        <PackageReference Include="Cratis.Specifications.XUnit.v3" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Shop/Shop.csproj" />
    </ItemGroup>
</Project>
