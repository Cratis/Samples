    <PackageVersion Include="Cratis.Arc.Chronicle" Version="22.125.3" />
    <PackageVersion Include="Cratis.Arc.Chronicle.Testing" Version="22.125.3" />
    <PackageVersion Include="Cratis.Arc.Screenplay.Embedded" Version="22.125.3" />
    <PackageVersion Include="Aspire.AppHost.Sdk" Version="13.4.2" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.MongoDB" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.1" />
    <PackageVersion Include="Cratis.AuthProxy.Aspire" Version="2.31.2" />
    <PackageVersion Include="Cratis.Chronicle" Version="19.88.3" />
    <PackageVersion Include="Cratis.Chronicle.AspNetCore" Version="19.88.3" />
    <PackageVersion Include="Cratis.Chronicle.Aspire" Version="19.88.3" />
    <PackageVersion Include="Cratis.Chronicle.Testing" Version="19.88.3" />
    <PackageVersion Include="Cratis.Chronicle.XUnit.Integration" Version="19.88.3" />
    <PackageVersion Include="Marten" Version="9.49.0" />
    <PackageVersion Include="WolverineFx" Version="6.49.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.49.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.49.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.49.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <!-- Analysis -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="MongoDB.Driver" Version="3.12.0" />
    <PackageVersion Include="SharpCompress" Version="0.50.5" />
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.299" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
