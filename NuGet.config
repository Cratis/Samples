<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!-- A local feed belongs in a machine-level NuGet.config, not here. Committed as an absolute path it
             existed on exactly one machine, and every restore anywhere else - CI included - failed with NU1301
             before it reached nuget.org, because a source that cannot be reached is an error rather than a
             source to skip. To use one, add it with `dotnet nuget add source <path> --name LocalFeed`. -->
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
</configuration>
